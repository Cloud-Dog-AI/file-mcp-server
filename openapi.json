{
  "openapi": "3.1.0",
  "info": {
    "title": "File MCP Server HTTP API",
    "version": "1.1.0",
    "description": "HTTP surface for file-mcp-server FastMCP runtime. MCP tool execution is exposed via /mcp. Admin Google Drive setup endpoints are optional and require admin UI enablement."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns runtime status and active profile/transport indicators.",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "file-mcp-server"
                    },
                    "application": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "example": "file-mcp-server"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "runtime": {
                      "type": "object",
                      "properties": {
                        "env_file": {
                          "type": "string",
                          "example": "private/env-test"
                        }
                      },
                      "required": [
                        "env_file"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "example": "default"
                    },
                    "transport": {
                      "type": "string",
                      "example": "streamable-http"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "application",
                    "runtime",
                    "profile",
                    "transport"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP Tool Endpoint",
        "description": "FastMCP streamable HTTP endpoint for MCP/JSON-RPC tool discovery and invocation.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "MCP streamable HTTP payload (protocol-defined JSON-RPC-like envelope).",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP response payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/admin/google-drive": {
      "get": {
        "summary": "Google Drive Setup Page",
        "description": "Returns HTML setup form for Google Drive OAuth/profile binding. Requires admin UI enablement.",
        "security": [
          {
            "adminTokenHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTML setup page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (admin token mismatch)"
          },
          "404": {
            "description": "Admin UI disabled"
          }
        }
      }
    },
    "/admin/google-drive/start": {
      "post": {
        "summary": "Start Google OAuth",
        "description": "Accepts setup form fields and redirects to Google OAuth authorization URL.",
        "security": [
          {
            "adminTokenHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string"
                  },
                  "user_email": {
                    "type": "string"
                  },
                  "folder_input": {
                    "type": "string"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string"
                  }
                },
                "required": [
                  "profile",
                  "folder_input",
                  "client_id",
                  "client_secret",
                  "redirect_uri"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to Google OAuth authorization URL"
          },
          "400": {
            "description": "Invalid form input"
          },
          "401": {
            "description": "Unauthorized (admin token mismatch)"
          },
          "404": {
            "description": "Admin UI disabled"
          }
        }
      }
    },
    "/admin/google-drive/callback": {
      "get": {
        "summary": "Google OAuth Callback",
        "description": "Processes OAuth callback, writes profile config, and optionally hot-reloads runtime.",
        "security": [
          {
            "adminTokenHeader": []
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error_description",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OAuth link completed",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "OAuth callback failed or missing parameters",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (admin token mismatch)"
          },
          "404": {
            "description": "Admin UI disabled"
          }
        }
      }
    },
    "/admin/reload": {
      "post": {
        "summary": "Reload Active Configuration",
        "description": "Reloads profile/config/defaults in-process. Requires admin UI enablement.",
        "security": [
          {
            "adminTokenHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reload completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "ok",
                    "result"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Reload failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (admin token mismatch)"
          },
          "404": {
            "description": "Admin UI disabled"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key"
      },
      "adminTokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token",
        "description": "Optional admin token header. If FILE_MCP_ADMIN_UI_TOKEN is set, token is required via this header or ?token query param."
      }
    }
  }
}

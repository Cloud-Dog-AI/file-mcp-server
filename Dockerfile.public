# syntax=docker/dockerfile:1
# Apache-2.0
# Copyright (C) Cloud-Dog, Viewdeck Engineering Ltd.
# file-mcp-server — Dockerfile.public (PS-97 v1.1 §1.1.3)
#
# PUBLIC variant — for external / GitHub-boundary builds (e.g. ghcr.io, Docker Hub).
#
# Package source strategy (W28A-861-R3 §4 decision):
#   * Public boundary uses public PyPI (https://pypi.org/simple) for all
#     third-party dependencies. This is the build-time default of PYPI_INDEX_URL.
#   * Cloud-Dog platform packages (cloud-dog-config, cloud-dog-logging,
#     cloud-dog-api-kit, cloud-dog-idam, cloud-dog-db, cloud-dog-jobs,
#     cloud-dog-storage) MUST be published to the boundary index (pypi.org under
#     the Cloud-Dog-External namespace, or GitHub-mirrored source installed
#     ahead of this build) before this Dockerfile builds end-to-end. That
#     publish step is owned by the publication-loop lane (W28A-862-R3 / W28A-865).
#
# This variant never hardcodes an internal host and never uses --extra-index-url
# (PS-97 §3.3 / §4). The single index is supplied via the PYPI_INDEX_URL build
# arg (or the BuildKit pip.conf secret, which takes precedence if mounted).
#
# Select via: docker-build.sh --variant public

# ── Builder ──────────────────────────────────────────────────────
# W28R-3013 supply-chain remediation: public base bumped python:3.12-slim ->
# python:3.13-slim (clears the fixable CPython High CVEs). The public variant
# intentionally stays on the public boundary base (built by publication lanes);
# the internal deployed image (Dockerfile) uses the internal Cloud-Dog 3.13.14 base.
FROM python:3.13-slim AS builder

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}
ENV no_proxy=${no_proxy}

WORKDIR /app

# Public build — system ca-certificates trust store is sufficient for public
# package indexes. No private CA overlay.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      gcc \
      libxml2-dev \
      libxslt1-dev \
      libmagic1 \
      libmagic-dev \
      curl; \
    rm -rf /var/lib/apt/lists/*

COPY REQUIREMENTS.txt ./REQUIREMENTS.txt
# Single boundary index — public PyPI by default. No --extra-index-url (PS-97 §3.3).
# The active index (and any credentials) is supplied by the BuildKit pip.conf
# secret, which docker-build.sh writes as a single authenticated/anonymous
# `index-url` for the public variant. We deliberately do NOT pass `--index-url`
# on the pip CLI: a CLI `--index-url` overrides (and thus discards the credentials
# in) the mounted pip.conf, which breaks authenticated boundary indexes such as
# the internal package index. When no pip.conf is
# mounted, the PYPI_INDEX_URL build-arg below seeds a credential-less default.
#
# Note: pip precedence is CLI > env var (PIP_INDEX_URL) > config file. To let the
# mounted, possibly-authenticated pip.conf drive the index, we neither pass
# `--index-url` nor export `PIP_INDEX_URL`; PYPI_INDEX_URL is retained as a build
# arg only so callers/tooling can record the intended public default.
ARG PYPI_INDEX_URL=https://pypi.org/simple
RUN --mount=type=secret,id=pip_conf,target=/etc/pip.conf \
    pip install --no-cache-dir \
      "cloud-dog-config==0.3.5" \
      "cloud-dog-logging==0.4.1" \
      "cloud-dog-api-kit[change-stream-db]==0.14.1" \
      "cloud-dog-idam==0.5.4" \
      "cloud-dog-llm==0.4.1" \
      "cloud-dog-db==0.3.3" \
      "cloud-dog-jobs==0.4.4" \
      "cloud-dog-storage==0.1.8"
RUN --mount=type=secret,id=pip_conf,target=/etc/pip.conf \
    grep -v '^cloud_dog_' REQUIREMENTS.txt > /tmp/REQUIREMENTS.docker.txt && \
    pip install --no-cache-dir -r /tmp/REQUIREMENTS.docker.txt && \
    pip install --no-cache-dir 'redis>=5.0'

# ── Final ────────────────────────────────────────────────────────
FROM python:3.13-slim
ARG SOURCE_COMMIT=unknown
ARG SOURCE_BRANCH=unknown
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.vendor="Cloud-Dog, Viewdeck Engineering Limited"
LABEL org.opencontainers.image.source="https://github.com/cloud-dog-ai/file-mcp-server"
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"
LABEL org.opencontainers.image.ref.name="${SOURCE_BRANCH}"

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}
ENV no_proxy=${no_proxy}

WORKDIR /app

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      netcat-openbsd \
      procps \
      net-tools \
      libmagic1 \
      pandoc; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src ./src
COPY scripts ./scripts
COPY pyproject.toml ./pyproject.toml
COPY server_control.sh ./server_control.sh
COPY defaults.yaml ./defaults.yaml
COPY config.yaml ./config.yaml
COPY README.md ./README.md
COPY LICENSE ./LICENSE
COPY docker-env.public.example ./docker-env.example
COPY env-docker-defaults ./env-docker-defaults
COPY docker-entrypoint.sh ./docker-entrypoint.sh
COPY healthcheck.sh ./healthcheck.sh
COPY database ./database
COPY ui ./ui

RUN mkdir -p /app/.run /app/logs /app/certs /app/storage /app/tmp /app/archive
RUN chmod +x /app/docker-entrypoint.sh /app/healthcheck.sh /app/server_control.sh

RUN useradd --system --create-home --uid 10001 appuser && \
    chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV FILE_MCP_HEALTH_HOST=127.0.0.1
ENV FILE_MCP_HEALTH_PATH=/health

# Unified HTTP surface (default FILE_MCP_HTTP_PORT / CLOUD_DOG__WEB_SERVER__PORT).
# The entrypoint port-proxy forwards the PS-92 API/MCP ports to this port.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
  CMD /app/healthcheck.sh

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["serve"]

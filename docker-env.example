# Copyright (C) Cloud-Dog, Viewdeck Engineering Ltd.
# Copy this file and adapt values for your deployment.

# Authentication
FILE_MCP_API_KEY_PRIMARY=change-me
FILE_MCP_AUTH_HEADER_NAME=Authorization
FILE_MCP_AUTH_HEADER_SCHEME=Bearer

# Scope and logs
FILE_MCP_ROOT=/workspace
FILE_MCP_AUDIT_LOG=/workspace/logs/audit.log.jsonl
FILE_MCP_SERVER_LOG=/workspace/logs/server.log
FILE_MCP_SNAPSHOT_DIR=/workspace/logs/snapshots

# HTTP runtime
FILE_MCP_HTTP_TRANSPORT=streamable-http
FILE_MCP_HTTP_HOST=0.0.0.0
FILE_MCP_HTTP_PORT=8000
FILE_MCP_HTTP_BASE_PATH=/
FILE_MCP_HTTP_MCP_PATH=/mcp
FILE_MCP_HTTP_HEALTH_PATH=/health
FILE_MCP_HTTP_EVENTS_PATH=/events
FILE_MCP_HTTP_STATELESS=true

# Optional admin UI for Google Drive OAuth/profile setup pages
FILE_MCP_ADMIN_UI_ENABLED=false
# FILE_MCP_ADMIN_UI_TOKEN=change-me
# Auto-apply updated config in-memory after OAuth callback (no process restart)
FILE_MCP_ADMIN_APPLY_ON_CALLBACK=true

# Limits
FILE_MCP_SEARCH_MAX_RESULTS=250
FILE_MCP_SEARCH_MAX_FILE_MB=5
FILE_MCP_SEARCH_TIMEOUT_S=30
FILE_MCP_STORAGE_TIMEOUT_S=30
FILE_MCP_CONVERSION_TIMEOUT_S=60
FILE_MCP_CONVERSION_MAX_INPUT_MB=25

# Storage backend (default: local filesystem)
FILE_MCP_STORAGE_BACKEND=local
# Backend TLS controls (remote backends only)
FILE_MCP_STORAGE_TLS_INSECURE=false
# FILE_MCP_STORAGE_TLS_CA_BUNDLE=/app/certs/ca.crt

# Startup endpoint health checking and retry behavior
FILE_MCP_ENDPOINT_HEALTH_ENABLED=true
FILE_MCP_ENDPOINT_HEALTH_CHECK_ON_STARTUP=true
FILE_MCP_ENDPOINT_HEALTH_CHECK_ALL=true
FILE_MCP_ENDPOINT_HEALTH_MAX_RETRIES=3
FILE_MCP_ENDPOINT_HEALTH_RETRY_INTERVAL_S=2
FILE_MCP_ENDPOINT_HEALTH_RETRY_WINDOW_S=30
FILE_MCP_ENDPOINT_HEALTH_MAX_FAILURES_BEFORE_RESTART=5
FILE_MCP_ENDPOINT_HEALTH_RECOVER_AFTER_S=30
# Exit server process when restart threshold is reached (for supervisor/container restart policies)
FILE_MCP_ENDPOINT_HEALTH_RESTART_ON_THRESHOLD=false
FILE_MCP_ENDPOINT_HEALTH_RESTART_EXIT_CODE=75

# S3 backend settings
# FILE_MCP_S3_ENDPOINT=https://storage.example.com
# FILE_MCP_S3_BUCKET=my-bucket
# FILE_MCP_S3_REGION=us-east-1
# FILE_MCP_S3_ACCESS_KEY=...
# FILE_MCP_S3_SECRET_KEY=...
# FILE_MCP_S3_PREFIX=

# WebDAV backend settings
# FILE_MCP_WEBDAV_BASE_URL=https://files.example.com/remote.php/dav/files/user/root
# FILE_MCP_WEBDAV_USERNAME=...
# FILE_MCP_WEBDAV_PASSWORD=...
# Optional resilience controls for MOVE operations (defaults shown)
# FILE_MCP_WEBDAV_MOVE_RETRY_COUNT=2
# FILE_MCP_WEBDAV_MOVE_RETRY_BACKOFF_S=0.35
# FILE_MCP_WEBDAV_MOVE_PROBE_TIMEOUT_S=5
# FILE_MCP_WEBDAV_MOVE_RETRY_STATUSES=408,409,423,425,429,500,502,503,504

# FTP backend settings
# FILE_MCP_FTP_HOST=ftp.example.com
# FILE_MCP_FTP_PORT=21
# FILE_MCP_FTP_USERNAME=...
# FILE_MCP_FTP_PASSWORD=...
# FILE_MCP_FTP_BASE_DIR=/
# FILE_MCP_FTP_USE_TLS=false

# Google Drive backend settings
# FILE_MCP_STORAGE_BACKEND=google_drive
# FILE_MCP_GDRIVE_USER_EMAIL=
# FILE_MCP_GDRIVE_FOLDER_ID=
# FILE_MCP_GDRIVE_FOLDER_URL=
# FILE_MCP_GDRIVE_CLIENT_ID=
# FILE_MCP_GDRIVE_CLIENT_SECRET=
# FILE_MCP_GDRIVE_REFRESH_TOKEN=
# FILE_MCP_GDRIVE_ACCESS_TOKEN=
# FILE_MCP_GDRIVE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
# FILE_MCP_GDRIVE_TOKEN_URI=https://oauth2.googleapis.com/token

# Snapshot controls
FILE_MCP_SNAPSHOT_RETENTION_DAYS=30
FILE_MCP_SNAPSHOT_RETENTION_COUNT=-1
FILE_MCP_SNAPSHOT_MAX_STORAGE_MB=-1

# Optional TLS trust bundle mounted from host, e.g. /app/certs/ca.crt
# FILE_MCP_TLS_CA_BUNDLE=/app/certs/ca.crt
# REQUESTS_CA_BUNDLE=/app/certs/ca.crt

# file-mcp-server example environment (non-secret)
# Precedence: os.environ -> --env file -> config.yaml -> defaults.yaml

# Core profile/auth
FILE_MCP_API_KEY_PRIMARY=change-me
FILE_MCP_API_KEY_SECONDARY=
FILE_MCP_AUTH_HEADER_NAME=Authorization
FILE_MCP_AUTH_HEADER_SCHEME=Bearer
FILE_MCP_ROOT=.

# Runtime paths
FILE_MCP_AUDIT_LOG=./working/example/audit.log.jsonl
FILE_MCP_SERVER_LOG=./working/example/server.log
FILE_MCP_SNAPSHOT_DIR=./working/example/snapshots

# HTTP transport
FILE_MCP_HTTP_TRANSPORT=streamable-http
FILE_MCP_HTTP_HOST=127.0.0.1
FILE_MCP_HTTP_PORT=38190
FILE_MCP_HTTP_BASE_PATH=/app/v1
FILE_MCP_HTTP_MCP_PATH=/mcp
FILE_MCP_HTTP_HEALTH_PATH=/health
FILE_MCP_HTTP_EVENTS_PATH=/events
FILE_MCP_HTTP_STATELESS=true

# Limits and timeouts
FILE_MCP_SEARCH_MAX_RESULTS=250
FILE_MCP_SEARCH_MAX_FILE_MB=5
FILE_MCP_SEARCH_TIMEOUT_S=30
FILE_MCP_STORAGE_TIMEOUT_S=30
FILE_MCP_CONVERSION_TIMEOUT_S=60
FILE_MCP_CONVERSION_MAX_INPUT_MB=25

# Storage backend selector
FILE_MCP_STORAGE_BACKEND=local
FILE_MCP_STORAGE_TLS_INSECURE=false
FILE_MCP_STORAGE_TLS_CA_BUNDLE=

# Optional database dialect (cloud_dog_db)
CLOUD_DOG__DB__DIALECT=sqlite
CLOUD_DOG__DB__DATABASE=./database/file_mcp.db

#
# Deployment/runtime environment template used by migration source-audit tooling.
# Replace placeholder values for your deployment target.

# Authentication
FILE_MCP_API_KEY_PRIMARY=change-me
FILE_MCP_AUTH_HEADER_NAME=Authorization
FILE_MCP_AUTH_HEADER_SCHEME=Bearer

# Runtime profile and scope
FILE_MCP_STORAGE_BACKEND=local
FILE_MCP_ROOT=/workspace

# TLS controls
FILE_MCP_STORAGE_TLS_INSECURE=false
FILE_MCP_STORAGE_TLS_CA_BUNDLE=

# S3 backend non-secret routing fields
FILE_MCP_S3_ENDPOINT=https://storage.example.com
FILE_MCP_S3_BUCKET=example-bucket
FILE_MCP_S3_REGION=us-east-1
FILE_MCP_S3_PREFIX=

# WebDAV backend routing field
FILE_MCP_WEBDAV_BASE_URL=https://files.example.com/remote.php/dav/files/user/root

# FTP backend routing fields
FILE_MCP_FTP_HOST=ftp.example.com
FILE_MCP_FTP_PORT=21
FILE_MCP_FTP_BASE_DIR=/
FILE_MCP_FTP_USE_TLS=false

# Audit/snapshots/logging
FILE_MCP_AUDIT_LOG=/workspace/logs/audit.log.jsonl
FILE_MCP_SERVER_LOG=/workspace/logs/server.log
FILE_MCP_SNAPSHOT_DIR=/workspace/logs/snapshots
FILE_MCP_SNAPSHOT_RETENTION_DAYS=30
FILE_MCP_SNAPSHOT_RETENTION_COUNT=-1
FILE_MCP_SNAPSHOT_MAX_STORAGE_MB=-1

# Limits
FILE_MCP_CONVERSION_MAX_INPUT_MB=25
FILE_MCP_SEARCH_MAX_RESULTS=250
FILE_MCP_SEARCH_MAX_FILE_MB=5
FILE_MCP_SEARCH_TIMEOUT_S=30
FILE_MCP_STORAGE_TIMEOUT_S=30
FILE_MCP_CONVERSION_TIMEOUT_S=60

# HTTP transport
FILE_MCP_HTTP_TRANSPORT=streamable-http
FILE_MCP_HTTP_HOST=0.0.0.0
FILE_MCP_HTTP_PORT=8000
FILE_MCP_HTTP_BASE_PATH=/
FILE_MCP_HTTP_MCP_PATH=/mcp
FILE_MCP_HTTP_HEALTH_PATH=/health
FILE_MCP_HTTP_EVENTS_PATH=/events
FILE_MCP_HTTP_STATELESS=true

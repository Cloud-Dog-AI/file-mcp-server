# Preprod all-4-in-one container env example for file-mcp-server.
# Intended to be used with a mounted multi-profile config file:
#   docker-config.profiles.example.yaml -> /workspace/config.yaml
#
# Runtime prerequisites:
# 1) Vault bootstrap env vars must be injected by orchestrator/runtime:
#    - VAULT_ADDR
#    - VAULT_TOKEN
#    - VAULT_MOUNT_POINT
#    - VAULT_CONFIG_PATH
#    - VAULT_NAMESPACE (optional)
# 2) Host mounts (example):
#    - /srv/file-mcp/workspace -> /workspace
#    - /srv/file-mcp/logs -> /workspace/logs
#    - /srv/file-mcp/config.yaml -> /workspace/config.yaml:ro
#
# Notes:
# - Default values from defaults.yaml / env-docker-defaults are omitted.
# - Vault expressions are resolved by cloud_dog_config at runtime.

# Multi-profile runtime wiring
FILE_MCP_CONFIG_PATH=/workspace/config.yaml
FILE_MCP_PROFILE=local
FILE_MCP_STORAGE_BACKEND=local
FILE_MCP_STORAGE_TLS_INSECURE=false
FILE_MCP_STORAGE_TLS_CA_BUNDLE=

# Canonical API route prefix used by latest runtime contracts.
FILE_MCP_HTTP_TRANSPORT=streamable-http
FILE_MCP_HTTP_HOST=0.0.0.0
FILE_MCP_HTTP_BASE_PATH=/app/v1
FILE_MCP_HTTP_PORT=18090
FILE_MCP_HTTP_MCP_PATH=/mcp
FILE_MCP_HTTP_HEALTH_PATH=/health
FILE_MCP_HTTP_EVENTS_PATH=/events
FILE_MCP_HTTP_STATELESS=true

# Scope + logs
FILE_MCP_ROOT=/workspace
FILE_MCP_AUDIT_LOG=/workspace/logs/audit.log.jsonl
FILE_MCP_SERVER_LOG=/workspace/logs/server.log
FILE_MCP_SNAPSHOT_DIR=/workspace/logs/snapshots

# Auth contract (profile-specific keys for local/s3/webdav/ftp profiles)
FILE_MCP_AUTH_HEADER_NAME=Authorization
FILE_MCP_AUTH_HEADER_SCHEME=Bearer
FILE_MCP_API_KEY_LOCAL=changeme
FILE_MCP_API_KEY_S3=changeme
FILE_MCP_API_KEY_WEBDAV=changeme
FILE_MCP_API_KEY_FTP=changeme

# Compatibility + A2A test contract key
FILE_MCP_API_KEY_PRIMARY=changeme
FILE_MCP_API_KEY_SECONDARY=changeme
TEST_A2A_API_KEY=changeme

# Remote backend endpoints and credentials
# S3 / MinIO
FILE_MCP_S3_ENDPOINT=https://storage.example.com
FILE_MCP_S3_BUCKET=test
FILE_MCP_S3_REGION=us-east-1
FILE_MCP_S3_ACCESS_KEY=${vault.dev.storage.s3.access_key_id}
FILE_MCP_S3_SECRET_KEY=${vault.dev.storage.s3.secret_access_key}
FILE_MCP_S3_PREFIX=file-mcp/preprod

# WebDAV
FILE_MCP_WEBDAV_BASE_URL=https://files.example.com/remote.php/dav/files/user/temp
FILE_MCP_WEBDAV_USERNAME=${vault.dev.storage.webdav.username}
FILE_MCP_WEBDAV_PASSWORD=${vault.dev.storage.webdav.password}
FILE_MCP_WEBDAV_MOVE_RETRY_COUNT=2
FILE_MCP_WEBDAV_MOVE_RETRY_BACKOFF_S=0.35
FILE_MCP_WEBDAV_MOVE_PROBE_TIMEOUT_S=5
FILE_MCP_WEBDAV_MOVE_RETRY_STATUSES=408,409,423,425,429,500,502,503,504

# FTP
FILE_MCP_FTP_HOST=ftp.example.com
FILE_MCP_FTP_PORT=21
FILE_MCP_FTP_USERNAME=${vault.dev.storage.ftp.username}
FILE_MCP_FTP_PASSWORD=${vault.dev.storage.ftp.password}
FILE_MCP_FTP_BASE_DIR=/
FILE_MCP_FTP_USE_TLS=false

# Google Drive client credentials from Vault.
# Tokens/folder are deployment-specific and should be set per environment.
FILE_MCP_GDRIVE_CLIENT_ID=${vault.dev.storage.google_drive.client_id}
FILE_MCP_GDRIVE_CLIENT_SECRET=${vault.dev.storage.google_drive.client_secret}
FILE_MCP_GDRIVE_TOKEN_URI=changeme
FILE_MCP_GDRIVE_REDIRECT_URI=http://127.0.0.1:18090/admin/google-drive/callback
FILE_MCP_GDRIVE_USER_EMAIL=
FILE_MCP_GDRIVE_FOLDER_ID=
FILE_MCP_GDRIVE_FOLDER_URL=
FILE_MCP_GDRIVE_REFRESH_TOKEN=
FILE_MCP_GDRIVE_ACCESS_TOKEN=

# Admin UI (optional but recommended for remote Google OAuth onboarding)
FILE_MCP_ADMIN_UI_ENABLED=true
FILE_MCP_ADMIN_APPLY_ON_CALLBACK=true

# External matrix test gates (enabled for preprod validation runs)
FILE_MCP_RUN_DOCKER_TESTS=1
FILE_MCP_RUN_DOCKER_REMOTE_STORAGE_TESTS=1
FILE_MCP_RUN_DOCKER_BRIDGE_TESTS=1
FILE_MCP_RUN_REMOTE_MATRIX_TESTS=1
FILE_MCP_RUN_GOOGLE_LIVE_TESTS=1
FILE_MCP_STRICT_REMOTE_TESTS=1

# Test base paths
TEST_API_BASE_PATH=/app/v1
TEST_MCP_BASE_PATH=/mcp
TEST_WEB_BASE_PATH=/
TEST_A2A_BASE_PATH=/a2a

# Preprod AT profile-chain defaults (AT1.6 macro flow)
FILE_MCP_RUN_PREPROD_AT=1
FILE_MCP_PREPROD_URL=http://127.0.0.1:18090
FILE_MCP_PREPROD_PROFILE_LOCAL=local
FILE_MCP_PREPROD_PROFILE_S3=s3
FILE_MCP_PREPROD_PROFILE_WEBDAV=webdav
FILE_MCP_PREPROD_PROFILE_FTP=ftp
FILE_MCP_PREPROD_KEY_LOCAL=preprod-local-key
FILE_MCP_PREPROD_KEY_S3=preprod-s3-key
FILE_MCP_PREPROD_KEY_WEBDAV=preprod-webdav-key
FILE_MCP_PREPROD_KEY_FTP=preprod-ftp-key
FILE_MCP_PREPROD_AT_BASE_DIR=/workspace/at-profile-chain
FILE_MCP_PREPROD_AT_FILENAME=chain.txt

CLOUD_DOG__DB__DIALECT=sqlite
CLOUD_DOG__DB__DATABASE=./database/file_mcp.db
